/* ============================================
   HostAI — Design System v3
   Premium property management interface
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

/* ---- Design Tokens ---- */
:root {
  /* Brand — warm coral, refined */
  --clr-primary:        #E8514A;
  --clr-primary-dark:   #C23832;
  --clr-primary-light:  #FFF1F0;
  --clr-primary-hover:  #D4433C;
  --clr-accent:         #1A8D84;
  --clr-accent-light:   #E8F7F5;

  /* Neutrals — warm gray palette */
  --clr-bg:             #F5F5F3;
  --clr-bg-elevated:    #FAFAF8;
  --clr-surface:        #FFFFFF;
  --clr-border:         #E8E6E1;
  --clr-border-subtle:  #F0EEEA;
  --clr-border-focus:   var(--clr-primary);
  --clr-text:           #1A1A1A;
  --clr-text-secondary: #4A4A4A;
  --clr-text-muted:     #8A8A8A;
  --clr-text-light:     #B0B0B0;

  /* Semantic */
  --clr-success:        #2D9D78;
  --clr-success-light:  #E8F5EF;
  --clr-warning:        #E5A117;
  --clr-warning-light:  #FEF5E0;
  --clr-danger:         #DC4444;
  --clr-danger-light:   #FDE8E8;
  --clr-info:           #3B82F6;
  --clr-info-light:     #EBF2FF;

  /* Elevation */
  --shadow-xs:   0 1px 2px rgba(0,0,0,.04);
  --shadow-sm:   0 1px 3px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.03);
  --shadow-md:   0 4px 12px rgba(0,0,0,.06), 0 1px 4px rgba(0,0,0,.04);
  --shadow-lg:   0 8px 30px rgba(0,0,0,.08), 0 2px 8px rgba(0,0,0,.04);
  --shadow-xl:   0 20px 50px rgba(0,0,0,.10), 0 4px 16px rgba(0,0,0,.06);

  /* Radius */
  --radius-xs:   4px;
  --radius-sm:   6px;
  --radius-md:   10px;
  --radius-lg:   14px;
  --radius-xl:   20px;
  --radius-full: 9999px;

  /* Motion */
  --ease-micro:  .12s cubic-bezier(.4,0,.2,1);
  --ease-fast:   .18s cubic-bezier(.4,0,.2,1);
  --ease-normal: .28s cubic-bezier(.4,0,.2,1);
  --ease-slow:   .4s  cubic-bezier(.22,1,.36,1);
  --ease-bounce: .5s  cubic-bezier(.34,1.56,.64,1);

  /* Layout */
  --header-h: 60px;
  --sidebar-w: 240px;
  --max-content: 1180px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
  font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  background: var(--clr-bg);
  color: var(--clr-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection { background: var(--clr-primary-light); color: var(--clr-primary-dark); }

.skip-link {
  position: absolute; top: -100%; left: 0;
  padding: 12px 20px; background: var(--clr-text);
  color: #fff; font-weight: 600; font-size: .85rem;
  border-radius: 0 0 var(--radius-md) 0; z-index: 10000;
  transition: top var(--ease-fast);
}
.skip-link:focus { top: 0; }

/* ---- Typography ---- */
h1,h2,h3,h4,h5,h6 { font-weight: 700; line-height: 1.25; color: var(--clr-text); letter-spacing: -0.01em; }
h1 { font-size: clamp(1.4rem, 2.5vw, 1.75rem); }
h2 { font-size: clamp(1.15rem, 2vw, 1.35rem); }
h3 { font-size: 1.05rem; }
p  { color: var(--clr-text-secondary); }
a  { color: var(--clr-primary); text-decoration: none; transition: color var(--ease-fast); }
a:hover { color: var(--clr-primary-dark); }
a:focus-visible { outline: 2px solid var(--clr-primary); outline-offset: 3px; border-radius: 4px; }

.container { width: 100%; max-width: var(--max-content); margin-inline: auto; padding-inline: clamp(16px, 3vw, 28px); }

/* ============================================
   HEADER
   ============================================ */
header {
  position: sticky; top: 0; z-index: 500;
  height: var(--header-h);
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--clr-border);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
}
header .container { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 0; }

.logo {
  display: flex; align-items: center; gap: 8px;
  font-size: 1.15rem; font-weight: 800; letter-spacing: -0.02em;
  color: var(--clr-text); text-decoration: none;
  transition: opacity var(--ease-fast);
}
.logo:hover { opacity: .7; text-decoration: none; }
.header-nav { display: flex; align-items: center; gap: 10px; }
.user-chip {
  display: flex; align-items: center; gap: 6px;
  padding: 5px 12px;
  background: var(--clr-bg);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-full);
  font-size: .78rem; color: var(--clr-text-muted); font-weight: 500;
}
.user-info { display: flex; align-items: center; gap: 12px; }
.user-email { font-size: .78rem; color: var(--clr-text-muted); font-weight: 500; }

/* ============================================
   BUTTONS
   ============================================ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 9px 18px;
  border: 1.5px solid transparent;
  border-radius: var(--radius-md);
  font-family: inherit; font-size: .835rem; font-weight: 600;
  cursor: pointer; white-space: nowrap; text-decoration: none;
  transition: all var(--ease-fast);
  user-select: none;
}
.btn:focus-visible { outline: 2px solid var(--clr-primary); outline-offset: 3px; }
.btn:active:not(:disabled) { transform: scale(.97); }
.btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }

.btn-primary {
  background: var(--clr-primary); color: #fff; border-color: var(--clr-primary);
  box-shadow: 0 1px 3px rgba(232,81,74,.2);
}
.btn-primary:hover:not(:disabled) {
  background: var(--clr-primary-hover); border-color: var(--clr-primary-hover);
  color: #fff; text-decoration: none;
  box-shadow: 0 4px 14px rgba(232,81,74,.28);
  transform: translateY(-1px);
}

.btn-secondary { background: var(--clr-accent); color: #fff; border-color: var(--clr-accent); }
.btn-secondary:hover:not(:disabled) { opacity: .9; color: #fff; text-decoration: none; }

.btn-outline {
  background: var(--clr-surface); color: var(--clr-text-secondary);
  border-color: var(--clr-border);
}
.btn-outline:hover:not(:disabled) {
  background: var(--clr-bg); border-color: var(--clr-text-light);
  text-decoration: none;
}

.btn-ghost { background: transparent; color: var(--clr-text-muted); border-color: transparent; }
.btn-ghost:hover:not(:disabled) { background: var(--clr-bg); color: var(--clr-text-secondary); }

.btn-danger { background: var(--clr-danger); color: #fff; border-color: var(--clr-danger); }
.btn-danger:hover:not(:disabled) { opacity: .9; color: #fff; text-decoration: none; }

.btn-sm   { padding: 6px 12px; font-size: .78rem; border-radius: var(--radius-sm); }
.btn-lg   { padding: 12px 24px; font-size: .95rem; }
.btn-icon { padding: 7px; aspect-ratio: 1; }
.btn-full { width: 100%; justify-content: center; }

/* ============================================
   FORMS
   ============================================ */
.form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 18px; }
label, .form-label { font-size: .8rem; font-weight: 600; color: var(--clr-text-secondary); }
.form-hint { font-size: .74rem; color: var(--clr-text-muted); }

input[type="text"],input[type="email"],input[type="password"],input[type="number"],input[type="url"],textarea,select {
  width: 100%; padding: 9px 12px;
  border: 1.5px solid var(--clr-border);
  border-radius: var(--radius-md);
  font-family: inherit; font-size: .84rem; color: var(--clr-text);
  background: var(--clr-surface);
  transition: border-color var(--ease-fast), box-shadow var(--ease-fast);
  -webkit-appearance: none;
  appearance: none;
}
textarea { resize: vertical; min-height: 90px; line-height: 1.6; }
input:focus,textarea:focus,select:focus {
  outline: none;
  border-color: var(--clr-primary);
  box-shadow: 0 0 0 3px rgba(232,81,74,.1);
}
input::placeholder,textarea::placeholder { color: var(--clr-text-light); }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }

.checkbox-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 8px; }
.checkbox-category { grid-column: 1 / -1; font-size: .72rem; font-weight: 700; color: var(--clr-text-muted); text-transform: uppercase; letter-spacing: .06em; padding: 10px 0 4px; border-top: 1px solid var(--clr-border-subtle); margin-top: 4px; }
.checkbox-category:first-child { border-top: none; margin-top: 0; padding-top: 0; }
.checkbox-item {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px;
  border: 1.5px solid var(--clr-border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--ease-fast);
  background: var(--clr-surface);
  font-size: .82rem; color: var(--clr-text-secondary); font-weight: 500;
  user-select: none;
}
.checkbox-item:hover { border-color: var(--clr-primary); background: var(--clr-primary-light); }
.checkbox-item input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--clr-primary); flex-shrink: 0; }
.checkbox-item input[type="checkbox"]:checked~span { color: var(--clr-primary); font-weight: 600; }

/* ============================================
   CARDS
   ============================================ */
.card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  padding: 22px;
  box-shadow: var(--shadow-xs);
  transition: box-shadow var(--ease-normal);
}
.card-hover:hover { box-shadow: var(--shadow-md); }
.card-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 14px; margin-bottom: 18px;
  border-bottom: 1px solid var(--clr-border-subtle);
}
.card-title { font-size: .95rem; font-weight: 700; color: var(--clr-text); }

/* ============================================
   ALERTS & TOASTS
   ============================================ */
.alert {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  font-size: .84rem; font-weight: 500;
  margin-bottom: 14px;
  border: 1px solid transparent;
}
.alert-error   { background: var(--clr-danger-light);  color: #B91C1C; border-color: #FECACA; }
.alert-success { background: var(--clr-success-light); color: #065F46; border-color: #A7F3D0; }
.alert-warning { background: var(--clr-warning-light); color: #856404; border-color: #FDE68A; }
.alert-info    { background: var(--clr-info-light);    color: #1D4ED8; border-color: #BFDBFE; }

.toast-container {
  position: fixed; top: calc(var(--header-h) + 12px); right: 16px;
  z-index: 9000; display: flex; flex-direction: column; gap: 8px;
  pointer-events: none;
}
.toast {
  pointer-events: all; min-width: 260px; max-width: 380px;
  padding: 12px 16px;
  border-radius: var(--radius-md);
  font-size: .835rem; font-weight: 500;
  box-shadow: var(--shadow-lg);
  display: flex; align-items: center; gap: 8px;
  animation: toastIn .3s cubic-bezier(.34,1.56,.64,1) forwards;
}
.toast.hide { animation: toastOut .2s ease forwards; }
.toast-success { background: #065F46; color: #fff; }
.toast-error   { background: #B91C1C; color: #fff; }
.toast-info    { background: var(--clr-text); color: #fff; }

/* ============================================
   AUTH
   ============================================ */
.auth-page { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
@media (max-width: 768px) { .auth-page { grid-template-columns: 1fr; } .auth-hero { display: none; } }

.auth-hero {
  background: linear-gradient(145deg, #1A1A1A 0%, #2D2D2D 40%, #3A3A3A 100%);
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  padding: 48px; color: #fff; text-align: center;
  position: relative; overflow: hidden;
}
.auth-hero::before { content:''; position:absolute; width:500px;height:500px; border-radius:50%; background:rgba(232,81,74,.06); top:-150px;right:-150px; }
.auth-hero::after  { content:''; position:absolute; width:350px;height:350px; border-radius:50%; background:rgba(26,141,132,.06); bottom:-100px;left:-100px; }
.auth-hero-icon { font-size: 4rem; margin-bottom: 20px; }
.auth-hero h1   { font-size: 1.8rem; color: #fff; margin-bottom: 12px; letter-spacing: -0.02em; }
.auth-hero p    { font-size: .95rem; color: rgba(255,255,255,.6); max-width: 300px; line-height: 1.7; }
.auth-hero-features { margin-top: 36px; display: flex; flex-direction: column; gap: 12px; text-align: left; width: 100%; max-width: 280px; }
.auth-hero-feature  { display: flex; align-items: center; gap: 10px; font-size: .85rem; color: rgba(255,255,255,.75); }
.auth-hero-feature .feat-icon {
  width: 30px; height: 30px; border-radius: var(--radius-sm);
  background: rgba(255,255,255,.08);
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem; flex-shrink: 0;
}

.auth-form-side {
  display: flex; flex-direction: column; justify-content: center;
  padding: 48px clamp(24px, 5vw, 56px);
  background: var(--clr-surface); overflow-y: auto;
}
.auth-form-header { margin-bottom: 32px; }
.auth-form-header h2 { font-size: 1.5rem; margin-bottom: 6px; }
.auth-form-header p  { font-size: .88rem; }
.auth-switch { margin-top: 22px; text-align: center; font-size: .84rem; color: var(--clr-text-muted); }

/* Legacy compat */
.auth-container { max-width: 400px; margin: 80px auto; padding: 36px; background: var(--clr-surface); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); }
.auth-title { text-align: center; margin-bottom: 28px; font-size: 1.6rem; }

/* ============================================
   DASHBOARD LAYOUT
   ============================================ */
.dashboard-layout {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  min-height: calc(100vh - var(--header-h));
}
@media (max-width: 900px) { .dashboard-layout { grid-template-columns: 1fr; } .dashboard-sidebar { display: none; } }

.dashboard-sidebar {
  background: var(--clr-surface);
  border-right: 1px solid var(--clr-border);
  padding: 16px 10px;
  display: flex; flex-direction: column; gap: 2px;
  position: sticky; top: var(--header-h);
  height: calc(100vh - var(--header-h)); overflow-y: auto;
}
.dashboard-sidebar::-webkit-scrollbar { width: 3px; }
.dashboard-sidebar::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 2px; }

.sidebar-section-label {
  font-size: .66rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--clr-text-light); padding: 14px 10px 6px;
}
.nav-item {
  display: flex; align-items: center; gap: 9px;
  padding: 9px 12px;
  border-radius: var(--radius-md);
  font-size: .84rem; font-weight: 500;
  color: var(--clr-text-muted); cursor: pointer;
  text-decoration: none; border: none; background: transparent;
  width: 100%; text-align: left;
  transition: all var(--ease-fast);
}
.nav-item:hover { background: var(--clr-bg); color: var(--clr-text); text-decoration: none; }
.nav-item.active {
  background: var(--clr-primary-light); color: var(--clr-primary-dark);
  font-weight: 600;
}
.nav-icon { font-size: 1rem; width: 20px; text-align: center; }
.nav-badge {
  margin-left: auto;
  background: var(--clr-primary); color: #fff;
  font-size: .65rem; font-weight: 700;
  padding: 1px 6px; border-radius: var(--radius-full);
  min-width: 18px; text-align: center;
}

.dashboard-main { padding: clamp(20px, 3vw, 32px); overflow-x: hidden; }
.dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; gap: 12px; }

/* ============================================
   STATS GRID
   ============================================ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 14px; margin-bottom: 28px;
}
.stat-card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  box-shadow: var(--shadow-xs);
  position: relative; overflow: hidden;
  transition: all var(--ease-normal);
  animation: fadeInUp .35s ease both;
}
.stat-card:hover { box-shadow: var(--shadow-sm); transform: translateY(-1px); }
.stat-card::after {
  content:''; position:absolute; bottom: 0; left: 0; right: 0;
  height: 3px; border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}
.stat-card.stat-blue::after   { background: var(--clr-info); }
.stat-card.stat-green::after  { background: var(--clr-accent); }
.stat-card.stat-orange::after { background: var(--clr-warning); }
.stat-card.stat-red::after    { background: var(--clr-primary); }
.stat-card:nth-child(1) { animation-delay: .04s; }
.stat-card:nth-child(2) { animation-delay: .08s; }
.stat-card:nth-child(3) { animation-delay: .12s; }
.stat-card:nth-child(4) { animation-delay: .16s; }
.stat-icon  { font-size: 1.3rem; margin-bottom: 10px; display:block; }
.stat-value { font-size: 1.75rem; font-weight: 800; color: var(--clr-text); line-height: 1; margin-bottom: 4px; letter-spacing: -0.02em; }
.stat-label { font-size: .72rem; color: var(--clr-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; gap: 12px; flex-wrap: wrap; }
.section-header h2 { margin: 0; }

/* ============================================
   PROPERTY CARDS
   ============================================ */
.properties-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 16px; margin-bottom: 36px;
}
.property-card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  transition: all var(--ease-normal);
  animation: fadeInUp .3s ease both;
}
.property-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.property-card-accent {
  height: 3px;
  background: linear-gradient(90deg, var(--clr-primary) 0%, var(--clr-accent) 100%);
}
.property-card-body { padding: 18px; }
.property-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.property-header h3 { font-size: .95rem; color: var(--clr-text); flex: 1; padding-right: 8px; }
.property-type {
  background: var(--clr-bg); border: 1px solid var(--clr-border);
  padding: 2px 8px; border-radius: var(--radius-full);
  font-size: .68rem; font-weight: 600; color: var(--clr-text-muted);
  white-space: nowrap; text-transform: capitalize;
}
.property-meta { display: flex; flex-wrap: wrap; gap: 6px 12px; margin-bottom: 12px; }
.property-meta-item { display: flex; align-items: center; gap: 4px; font-size: .78rem; color: var(--clr-text-muted); font-weight: 500; }
.property-amenities { display: flex; flex-wrap: wrap; gap: 4px; padding-top: 12px; border-top: 1px solid var(--clr-border-subtle); margin-bottom: 12px; }
.amenity-tag {
  font-size: .7rem; background: var(--clr-bg);
  border: 1px solid var(--clr-border-subtle);
  padding: 2px 7px; border-radius: var(--radius-full);
  color: var(--clr-text-muted);
}
.property-actions { display: flex; gap: 6px; padding-top: 12px; border-top: 1px solid var(--clr-border-subtle); }
.property-details { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; font-size: 13px; color: var(--clr-text); }

/* Toggle switch */
.auto-reply-toggle { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: .78rem; color: var(--clr-text-muted); }
.toggle-switch { position: relative; display: inline-block; width: 36px; height: 20px; flex-shrink: 0; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-track {
  position: absolute; inset: 0;
  background: var(--clr-border);
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: background var(--ease-fast);
}
.toggle-track::before {
  content: ''; position: absolute; top: 2px; left: 2px;
  width: 16px; height: 16px; border-radius: 50%;
  background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.15);
  transition: transform var(--ease-fast);
}
.toggle-switch input:checked+.toggle-track { background: var(--clr-accent); }
.toggle-switch input:checked+.toggle-track::before { transform: translateX(16px); }

/* ============================================
   CONVERSATIONS
   ============================================ */
.conversations-list { display: flex; flex-direction: column; gap: 6px; }
.conversation-item {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 18px;
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-lg);
  cursor: pointer; text-decoration: none;
  transition: all var(--ease-fast);
  animation: fadeInUp .25s ease both;
}
.conversation-item:hover {
  border-color: var(--clr-primary);
  box-shadow: var(--shadow-sm);
  text-decoration: none;
  background: var(--clr-bg-elevated);
}
.conv-avatar {
  width: 40px; height: 40px; border-radius: var(--radius-full);
  background: var(--clr-text);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 1rem; font-weight: 700;
  flex-shrink: 0;
}
.conv-info { flex: 1; min-width: 0; }
.conv-info h3 {
  font-size: .88rem; font-weight: 600; color: var(--clr-text);
  margin-bottom: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.conversation-meta { font-size: .74rem; color: var(--clr-text-muted); }
.conv-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.conversation-info h3 { font-size: .88rem; margin-bottom: 4px; }

/* ============================================
   BADGES
   ============================================ */
.badge {
  display: inline-flex; align-items: center; gap: 3px;
  padding: 2px 8px; border-radius: var(--radius-full);
  font-size: .7rem; font-weight: 700; white-space: nowrap;
  letter-spacing: .02em;
}
.badge-status-inquiry    { background: var(--clr-warning-light); color: #856404; }
.badge-status-request    { background: var(--clr-info-light);    color: #1D4ED8; }
.badge-status-confirmed  { background: var(--clr-success-light); color: #065F46; }
.badge-status-checkedin  { background: var(--clr-accent-light);  color: var(--clr-accent); }
.badge-status-checkedout { background: var(--clr-bg); color: var(--clr-text-muted); border: 1px solid var(--clr-border); }
.badge.risk-low    { background: var(--clr-success-light); color: #065F46; }
.badge.risk-medium { background: var(--clr-warning-light); color: #856404; }
.badge.risk-high   { background: var(--clr-danger-light);  color: #B91C1C; }
.badge.escalate    { background: var(--clr-danger); color: #fff; }
.badge-escalate    { background: var(--clr-danger); color: #fff; }

/* ============================================
   CHAT
   ============================================ */
.chat-layout { display: grid; grid-template-columns: 1fr 340px; gap: 18px; align-items: start; }
@media (max-width: 900px) { .chat-layout { grid-template-columns: 1fr; } }

.messages-container {
  height: 440px; overflow-y: auto;
  padding: 16px;
  background: var(--clr-bg);
  border-radius: var(--radius-md);
  border: 1px solid var(--clr-border-subtle);
  display: flex; flex-direction: column; gap: 10px;
  scroll-behavior: smooth;
}
.messages-container::-webkit-scrollbar { width: 4px; }
.messages-container::-webkit-scrollbar-track { background: transparent; }
.messages-container::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 2px; }

.message {
  max-width: 72%; padding: 10px 14px;
  border-radius: var(--radius-lg);
  font-size: .84rem; line-height: 1.6;
  animation: msgIn .2s ease;
}
.message.incoming {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  margin-right: auto;
  border-bottom-left-radius: var(--radius-xs);
}
.message.outgoing {
  background: var(--clr-text);
  color: #fff;
  margin-left: auto;
  border-bottom-right-radius: var(--radius-xs);
  box-shadow: var(--shadow-sm);
}
.message.outgoing .message-time { color: rgba(255,255,255,.55); }
.message-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; gap: 10px; }
.message-sender { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; opacity: .7; }
.message-time { font-size: .68rem; color: var(--clr-text-muted); white-space: nowrap; }
.message-content { white-space: pre-wrap; word-break: break-word; }
.msg-empty { text-align: center; color: var(--clr-text-muted); font-size: .84rem; margin: auto; }

/* ============================================
   AI DRAFT
   ============================================ */
.draft-result {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-left: 4px solid var(--clr-accent);
  border-radius: var(--radius-lg);
  padding: 18px;
  margin-top: 16px;
  animation: fadeIn .3s ease;
}
.draft-result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; padding-bottom: 10px; border-bottom: 1px solid var(--clr-border-subtle); }
.draft-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; font-size: .78rem; }
.draft-meta-item { display: flex; align-items: center; gap: 4px; }
.host-note { background: var(--clr-danger-light); border-left: 3px solid var(--clr-danger); padding: 10px 14px; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: 12px; font-size: .84rem; }
.missing-questions { background: var(--clr-info-light); border-left: 3px solid var(--clr-info); padding: 10px 14px; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: 12px; font-size: .84rem; }
.missing-questions ul { margin-left: 16px; margin-top: 4px; color: var(--clr-text); }
.draft-content { background: var(--clr-bg-elevated); border: 1px solid var(--clr-border-subtle); padding: 14px; border-radius: var(--radius-md); white-space: pre-wrap; font-size: .86rem; line-height: 1.7; color: var(--clr-text); margin-bottom: 14px; }
.draft-actions { display: flex; flex-wrap: wrap; gap: 8px; }

/* ============================================
   MODAL
   ============================================ */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.4);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000; padding: 20px;
  animation: fadeIn .15s ease;
}
.modal.hidden { display: none; }
.modal-box {
  background: var(--clr-surface);
  border-radius: var(--radius-xl);
  width: 100%; max-width: 680px;
  max-height: calc(100vh - 40px); overflow-y: auto;
  box-shadow: var(--shadow-xl);
  animation: modalIn .25s cubic-bezier(.34,1.56,.64,1);
}
.modal-header {
  position: sticky; top: 0; background: var(--clr-surface);
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 24px 16px;
  border-bottom: 1px solid var(--clr-border);
  z-index: 2;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
}
.modal-body { padding: 24px; }
.form-section { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--clr-border-subtle); }
.form-section:last-of-type { border-bottom: none; margin-bottom: 0; }
.form-section-title { font-size: .88rem; font-weight: 700; color: var(--clr-text); margin-bottom: 14px; display: flex; align-items: center; gap: 8px; }

/* ============================================
   WEBHOOK / INTEGRATION
   ============================================ */
.webhook-panel {
  background: var(--clr-accent-light);
  border: 1px solid #C2E8E4;
  border-radius: var(--radius-lg);
  padding: 18px; margin-bottom: 18px;
}
.webhook-url-display {
  display: flex; align-items: center; gap: 8px;
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  padding: 8px 12px;
  font-family: 'SFMono-Regular',Consolas,'Liberation Mono',monospace;
  font-size: .78rem; color: var(--clr-text); word-break: break-all;
}

.integration-card {
  display: flex; align-items: center; gap: 14px;
  padding: 16px 18px;
  background: var(--clr-surface);
  border: 1.5px solid var(--clr-border);
  border-radius: var(--radius-lg);
  margin-bottom: 12px;
  transition: border-color var(--ease-fast);
}
.integration-card.connected { border-color: var(--clr-accent); background: var(--clr-accent-light); }
.integration-logo {
  width: 44px; height: 44px;
  border-radius: var(--radius-md);
  background: var(--clr-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; flex-shrink: 0;
  border: 1px solid var(--clr-border);
}
.integration-info { flex: 1; }
.integration-info h4 { font-size: .88rem; margin-bottom: 2px; }
.integration-info p  { font-size: .76rem; }

/* ============================================
   LOADING & EMPTY STATES
   ============================================ */
.loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 50px 20px; color: var(--clr-text-muted); gap: 12px; font-size: .86rem;
}
.spinner {
  width: 32px; height: 32px;
  border: 2.5px solid var(--clr-border);
  border-top-color: var(--clr-primary);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
.skeleton {
  background: linear-gradient(90deg,var(--clr-border) 25%,var(--clr-bg) 50%,var(--clr-border) 75%);
  background-size: 200% 100%;
  animation: skeleton-wave 1.4s ease infinite;
  border-radius: var(--radius-sm);
}

.empty-state { text-align: center; padding: 50px 20px; color: var(--clr-text-muted); }
.empty-state-icon { font-size: 2.8rem; margin-bottom: 14px; opacity: .5; }
.empty-state h3   { font-size: 1.05rem; color: var(--clr-text); margin-bottom: 6px; }
.empty-state p    { font-size: .84rem; margin-bottom: 20px; max-width: 300px; margin-inline: auto; }

/* ============================================
   UTILITIES
   ============================================ */
.hidden { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
.text-center { text-align: center; }
.text-muted { color: var(--clr-text-muted); }
.text-primary { color: var(--clr-primary); }
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.items-center { align-items: center; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }
.mb-1 { margin-bottom: 8px; }
.mb-2 { margin-bottom: 16px; }
.mb-3 { margin-bottom: 24px; }
.mt-2 { margin-top: 16px; }
.mt-3 { margin-top: 24px; }
.divider { border: none; border-top: 1px solid var(--clr-border); margin: 18px 0; }

/* ============================================
   IMPORT PREVIEW
   ============================================ */
.import-preview-card { background: var(--clr-bg); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); padding: 18px; }
.import-preview-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.import-preview-title { font-size: 1.05rem; font-weight: 700; color: var(--clr-text); margin-bottom: 4px; }
.import-preview-meta { display: flex; gap: 4px; align-items: center; flex-wrap: wrap; }
.import-preview-stats {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
  margin-bottom: 14px; padding: 14px;
  background: var(--clr-surface); border-radius: var(--radius-md); border: 1px solid var(--clr-border);
}
.import-stat { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.import-stat-val { font-size: 1.3rem; font-weight: 800; color: var(--clr-primary); line-height: 1; }
.import-stat-lbl { font-size: .68rem; color: var(--clr-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
.import-preview-amenities { display: flex; flex-wrap: wrap; gap: 6px; font-size: .78rem; color: var(--clr-text-muted); }
.import-preview-amenities span { background: var(--clr-surface); border: 1px solid var(--clr-border); padding: 3px 8px; border-radius: var(--radius-sm); }

/* ============================================
   ANIMATIONS
   ============================================ */
@keyframes spin            { to { transform: rotate(360deg); } }
@keyframes fadeIn          { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeInUp        { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
@keyframes msgIn           { from { opacity: 0; transform: translateY(6px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes modalIn         { from { opacity: 0; transform: scale(.95) translateY(16px); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes toastIn         { from { opacity: 0; transform: translateX(30px) scale(.97); } to { opacity: 1; transform: translateX(0) scale(1); } }
@keyframes toastOut        { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(30px); } }
@keyframes skeleton-wave   { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* Section transitions */
section[id^="section-"] { animation: fadeInUp .25s ease both; }

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 640px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .properties-list { grid-template-columns: 1fr; }
  .chat-layout { grid-template-columns: 1fr; }
  .message { max-width: 88%; }
  header { height: auto; min-height: var(--header-h); }
  .import-preview-stats { grid-template-columns: repeat(2, 1fr); }
}
