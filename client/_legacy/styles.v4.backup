/* ============================================
   HostAI — Design System v4
   Airbnb-inspired property management UI
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

:root {
  --clr-primary:        #FF385C;
  --clr-primary-dark:   #E31C5F;
  --clr-primary-light:  #FFF0F3;
  --clr-primary-hover:  #E0294D;
  --clr-accent:         #008489;
  --clr-accent-light:   #E6F6F6;

  --clr-bg:             #F7F7F7;
  --clr-bg-elevated:    #FAFAFA;
  --clr-surface:        #FFFFFF;
  --clr-border:         #DDDDDD;
  --clr-border-subtle:  #EBEBEB;
  --clr-border-focus:   var(--clr-text);
  --clr-text:           #222222;
  --clr-text-secondary: #484848;
  --clr-text-muted:     #717171;
  --clr-text-light:     #B0B0B0;

  --clr-success:        #008A05;
  --clr-success-light:  #E8F5E9;
  --clr-warning:        #E07912;
  --clr-warning-light:  #FFF8E1;
  --clr-danger:         #C13515;
  --clr-danger-light:   #FDE8E8;
  --clr-info:           #428BF9;
  --clr-info-light:     #EBF2FF;

  --shadow-xs:   0 1px 2px rgba(0,0,0,.06);
  --shadow-sm:   0 2px 4px rgba(0,0,0,.08);
  --shadow-md:   0 6px 16px rgba(0,0,0,.12);
  --shadow-lg:   0 12px 28px rgba(0,0,0,.12), 0 2px 8px rgba(0,0,0,.06);
  --shadow-xl:   0 20px 60px rgba(0,0,0,.15), 0 4px 16px rgba(0,0,0,.08);

  --radius-xs:   4px;
  --radius-sm:   8px;
  --radius-md:   12px;
  --radius-lg:   16px;
  --radius-xl:   24px;
  --radius-full: 9999px;

  --ease-fast:   .15s ease;
  --ease-normal: .25s ease;
  --ease-slow:   .4s ease;

  --header-h: 64px;
  --sidebar-w: 240px;
  --max-content: 1200px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
  font-family: 'Plus Jakarta Sans', -apple-system, 'Segoe UI', Roboto, sans-serif;
  background: var(--clr-bg);
  color: var(--clr-text);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection { background: var(--clr-primary-light); color: var(--clr-primary-dark); }

.skip-link {
  position: absolute; top: -100%; left: 0;
  padding: 12px 20px; background: var(--clr-text);
  color: #fff; font-weight: 600; font-size: .85rem;
  border-radius: 0 0 var(--radius-sm) 0; z-index: 10000;
  transition: top var(--ease-fast);
}
.skip-link:focus { top: 0; }

h1,h2,h3,h4,h5,h6 { font-weight: 600; line-height: 1.3; color: var(--clr-text); }
h1 { font-size: 1.625rem; }
h2 { font-size: 1.375rem; }
h3 { font-size: 1.0rem; }
p  { color: var(--clr-text-secondary); }
a  { color: var(--clr-text); text-decoration: underline; transition: color var(--ease-fast); }
a:hover { color: var(--clr-text); }
a:focus-visible { outline: 2px solid var(--clr-text); outline-offset: 2px; border-radius: 4px; }

.container { width: 100%; max-width: var(--max-content); margin-inline: auto; padding-inline: 24px; }

/* ============================================
   HEADER — Airbnb-style top bar
   ============================================ */
header {
  position: sticky; top: 0; z-index: 500;
  height: var(--header-h);
  background: var(--clr-surface);
  border-bottom: 1px solid var(--clr-border);
}
header .container { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }

.logo {
  display: flex; align-items: center; gap: 8px;
  font-size: 1.125rem; font-weight: 800;
  color: var(--clr-primary); text-decoration: none;
  letter-spacing: -0.02em;
}
.logo:hover { color: var(--clr-primary-dark); text-decoration: none; }
.logo svg { flex-shrink: 0; }

.header-nav { display: flex; align-items: center; gap: 8px; }
.user-chip {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 12px;
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-full);
  font-size: .8125rem; color: var(--clr-text-muted); font-weight: 500;
}
.user-info { display: flex; align-items: center; gap: 12px; }
.user-email { font-size: .8125rem; color: var(--clr-text-muted); font-weight: 500; }

/* ============================================
   BUTTONS — Airbnb rounded, clear hierarchy
   ============================================ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 10px 20px;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  font-family: inherit; font-size: .875rem; font-weight: 600;
  cursor: pointer; white-space: nowrap; text-decoration: none;
  transition: all var(--ease-fast);
  user-select: none;
}
.btn:focus-visible { outline: 2px solid var(--clr-text); outline-offset: 2px; }
.btn:active:not(:disabled) { transform: scale(.98); }
.btn:disabled { opacity: .4; cursor: not-allowed; transform: none; }

.btn-primary {
  background: var(--clr-primary); color: #fff; border-color: var(--clr-primary);
}
.btn-primary:hover:not(:disabled) {
  background: var(--clr-primary-hover); border-color: var(--clr-primary-hover);
  color: #fff; text-decoration: none;
}

.btn-secondary { background: var(--clr-text); color: #fff; border-color: var(--clr-text); }
.btn-secondary:hover:not(:disabled) { background: #000; color: #fff; text-decoration: none; }

.btn-outline {
  background: var(--clr-surface); color: var(--clr-text);
  border-color: var(--clr-text);
}
.btn-outline:hover:not(:disabled) {
  background: var(--clr-bg); text-decoration: none;
}

.btn-ghost { background: transparent; color: var(--clr-text-muted); border-color: transparent; }
.btn-ghost:hover:not(:disabled) { background: var(--clr-bg); color: var(--clr-text); }

.btn-danger { background: var(--clr-danger); color: #fff; border-color: var(--clr-danger); }
.btn-danger:hover:not(:disabled) { opacity: .9; color: #fff; text-decoration: none; }

.btn-sm   { padding: 6px 14px; font-size: .8125rem; border-radius: var(--radius-sm); }
.btn-lg   { padding: 14px 28px; font-size: 1rem; border-radius: var(--radius-md); }
.btn-icon { padding: 8px; aspect-ratio: 1; }
.btn-full { width: 100%; justify-content: center; }

/* ============================================
   FORMS — Clean Airbnb inputs
   ============================================ */
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
label, .form-label { font-size: .8125rem; font-weight: 600; color: var(--clr-text); }
.form-hint { font-size: .75rem; color: var(--clr-text-muted); }

input[type="text"],input[type="email"],input[type="password"],input[type="number"],input[type="url"],textarea,select {
  width: 100%; padding: 10px 12px;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  font-family: inherit; font-size: .875rem; color: var(--clr-text);
  background: var(--clr-surface);
  transition: border-color var(--ease-fast), box-shadow var(--ease-fast);
  -webkit-appearance: none;
  appearance: none;
}
textarea { resize: vertical; min-height: 80px; line-height: 1.5; }
input:focus,textarea:focus,select:focus {
  outline: none;
  border-color: var(--clr-text);
  box-shadow: 0 0 0 2px var(--clr-text);
}
input::placeholder,textarea::placeholder { color: var(--clr-text-light); }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; }

.checkbox-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 8px; }
.checkbox-category {
  grid-column: 1 / -1;
  font-size: .75rem; font-weight: 600; color: var(--clr-text-muted);
  text-transform: uppercase; letter-spacing: .04em;
  padding: 12px 0 4px;
  border-top: 1px solid var(--clr-border-subtle); margin-top: 4px;
}
.checkbox-category:first-child { border-top: none; margin-top: 0; padding-top: 0; }
.checkbox-item {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 12px;
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  cursor: pointer;
  transition: all var(--ease-fast);
  background: var(--clr-surface);
  font-size: .8125rem; color: var(--clr-text-secondary); font-weight: 500;
  user-select: none;
}
.checkbox-item:hover { border-color: var(--clr-text); }
.checkbox-item input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--clr-text); flex-shrink: 0; border-radius: 4px; }
.checkbox-item input[type="checkbox"]:checked~span { color: var(--clr-text); font-weight: 600; }

/* ============================================
   CARDS — Clean white, subtle border
   ============================================ */
.card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  padding: 24px;
  transition: box-shadow var(--ease-normal);
}
.card-hover:hover { box-shadow: var(--shadow-md); }
.card-header {
  display: flex; justify-content: space-between; align-items: center;
  padding-bottom: 16px; margin-bottom: 20px;
  border-bottom: 1px solid var(--clr-border-subtle);
}
.card-title { font-size: 1rem; font-weight: 600; color: var(--clr-text); }

/* ============================================
   ALERTS & TOASTS
   ============================================ */
.alert {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 14px 16px;
  border-radius: var(--radius-md);
  font-size: .875rem; font-weight: 500;
  margin-bottom: 16px;
  border: 1px solid transparent;
}
.alert-error   { background: #FDECEA; color: var(--clr-danger); border-color: #F5C6CB; }
.alert-success { background: var(--clr-success-light); color: var(--clr-success); border-color: #C8E6C9; }
.alert-warning { background: var(--clr-warning-light); color: #B06000; border-color: #FFE082; }
.alert-info    { background: var(--clr-info-light); color: #1565C0; border-color: #90CAF9; }

.toast-container {
  position: fixed; top: calc(var(--header-h) + 16px); right: 20px;
  z-index: 9000; display: flex; flex-direction: column; gap: 8px;
  pointer-events: none;
}
.toast {
  pointer-events: all; min-width: 280px; max-width: 400px;
  padding: 14px 20px;
  border-radius: var(--radius-md);
  font-size: .875rem; font-weight: 500;
  box-shadow: var(--shadow-lg);
  display: flex; align-items: center; gap: 10px;
  animation: toastIn .3s ease forwards;
  background: var(--clr-text); color: #fff;
}
.toast.hide { animation: toastOut .2s ease forwards; }
.toast-success { background: var(--clr-success); }
.toast-error   { background: var(--clr-danger); }
.toast-info    { background: var(--clr-text); }

/* ============================================
   AUTH — Split screen
   ============================================ */
.auth-page { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
@media (max-width: 768px) { .auth-page { grid-template-columns: 1fr; } .auth-hero { display: none; } }

.auth-hero {
  background: linear-gradient(160deg, var(--clr-primary) 0%, #E31C5F 50%, #BD1E59 100%);
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  padding: 48px; color: #fff; text-align: center;
  position: relative; overflow: hidden;
}
.auth-hero::before { content:''; position:absolute; width:600px;height:600px; border-radius:50%; background:rgba(255,255,255,.06); top:-200px;right:-200px; }
.auth-hero::after  { content:''; position:absolute; width:400px;height:400px; border-radius:50%; background:rgba(255,255,255,.04); bottom:-120px;left:-120px; }
.auth-hero-icon { font-size: 3rem; margin-bottom: 20px; }
.auth-hero h1 { font-size: 2rem; color: #fff; margin-bottom: 12px; font-weight: 800; }
.auth-hero p  { font-size: 1rem; color: rgba(255,255,255,.8); max-width: 320px; line-height: 1.6; }
.auth-hero-features { margin-top: 40px; display: flex; flex-direction: column; gap: 14px; text-align: left; width: 100%; max-width: 300px; }
.auth-hero-feature  { display: flex; align-items: center; gap: 12px; font-size: .9rem; color: rgba(255,255,255,.9); }
.auth-hero-feature .feat-icon {
  width: 36px; height: 36px; border-radius: var(--radius-sm);
  background: rgba(255,255,255,.15);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.auth-hero-feature .feat-icon svg { color: #fff; }

.auth-form-side {
  display: flex; flex-direction: column; justify-content: center;
  padding: 48px clamp(24px, 5vw, 56px);
  background: var(--clr-surface); overflow-y: auto;
}
.auth-form-header { margin-bottom: 32px; }
.auth-form-header h2 { font-size: 1.5rem; margin-bottom: 8px; font-weight: 700; }
.auth-form-header p  { font-size: .9375rem; }
.auth-switch { margin-top: 24px; text-align: center; font-size: .875rem; color: var(--clr-text-muted); }
.auth-switch a { color: var(--clr-primary); font-weight: 600; }

.auth-container { max-width: 400px; margin: 80px auto; padding: 36px; background: var(--clr-surface); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); }
.auth-title { text-align: center; margin-bottom: 28px; font-size: 1.6rem; }

/* ============================================
   DASHBOARD LAYOUT
   ============================================ */
.dashboard-layout {
  display: grid;
  grid-template-columns: var(--sidebar-w) 1fr;
  min-height: calc(100vh - var(--header-h));
}
@media (max-width: 900px) { .dashboard-layout { grid-template-columns: 1fr; } .dashboard-sidebar { display: none; } }

.dashboard-sidebar {
  background: var(--clr-surface);
  border-right: 1px solid var(--clr-border);
  padding: 20px 12px;
  display: flex; flex-direction: column; gap: 2px;
  position: sticky; top: var(--header-h);
  height: calc(100vh - var(--header-h)); overflow-y: auto;
}
.dashboard-sidebar::-webkit-scrollbar { width: 0; }

.sidebar-section-label {
  font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
  color: var(--clr-text-light); padding: 16px 12px 8px;
}
.nav-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  font-size: .875rem; font-weight: 500;
  color: var(--clr-text-muted); cursor: pointer;
  text-decoration: none; border: none; background: transparent;
  width: 100%; text-align: left;
  transition: all var(--ease-fast);
}
.nav-item:hover { background: var(--clr-bg); color: var(--clr-text); text-decoration: none; }
.nav-item.active {
  background: var(--clr-bg); color: var(--clr-text);
  font-weight: 600;
}
.nav-icon { display: flex; align-items: center; justify-content: center; width: 20px; height: 20px; flex-shrink: 0; color: inherit; }
.nav-icon svg { width: 18px; height: 18px; stroke-width: 2; }
.nav-badge {
  margin-left: auto;
  background: var(--clr-primary); color: #fff;
  font-size: .6875rem; font-weight: 700;
  padding: 2px 7px; border-radius: var(--radius-full);
  min-width: 20px; text-align: center;
}

.dashboard-main { padding: 32px; overflow-x: hidden; }
@media (max-width: 640px) { .dashboard-main { padding: 16px; } }
.dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; gap: 12px; }

/* ============================================
   STATS GRID — Clean cards
   ============================================ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px; margin-bottom: 32px;
}
.stat-card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  padding: 20px 24px;
  transition: box-shadow var(--ease-normal);
}
.stat-card:hover { box-shadow: var(--shadow-sm); }
.stat-icon {
  display: flex; align-items: center; justify-content: center;
  width: 40px; height: 40px;
  border-radius: var(--radius-sm);
  margin-bottom: 14px;
}
.stat-icon svg { width: 20px; height: 20px; stroke-width: 1.5; }
.stat-card.stat-blue .stat-icon   { background: var(--clr-info-light); color: var(--clr-info); }
.stat-card.stat-green .stat-icon  { background: var(--clr-accent-light); color: var(--clr-accent); }
.stat-card.stat-orange .stat-icon { background: var(--clr-warning-light); color: var(--clr-warning); }
.stat-card.stat-red .stat-icon    { background: var(--clr-primary-light); color: var(--clr-primary); }
.stat-value { font-size: 2rem; font-weight: 800; color: var(--clr-text); line-height: 1; margin-bottom: 4px; }
.stat-label { font-size: .8125rem; color: var(--clr-text-muted); font-weight: 500; }

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 12px; flex-wrap: wrap; }
.section-header h2 { margin: 0; }

/* ============================================
   PROPERTY CARDS — Airbnb listing style
   ============================================ */
.properties-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 20px; margin-bottom: 36px;
}
.property-card {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: box-shadow var(--ease-normal);
}
.property-card:hover { box-shadow: var(--shadow-md); }
.property-card-accent {
  height: 4px;
  background: linear-gradient(90deg, var(--clr-primary) 0%, var(--clr-primary-dark) 100%);
}
.property-card-body { padding: 20px; }
.property-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
.property-header h3 { font-size: 1rem; font-weight: 600; color: var(--clr-text); flex: 1; padding-right: 8px; line-height: 1.4; }
.property-type {
  background: var(--clr-bg);
  padding: 3px 10px; border-radius: var(--radius-full);
  font-size: .75rem; font-weight: 600; color: var(--clr-text-muted);
  white-space: nowrap; text-transform: capitalize;
}
.property-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; margin-bottom: 14px; }
.property-meta-item {
  display: flex; align-items: center; gap: 4px;
  font-size: .8125rem; color: var(--clr-text-secondary); font-weight: 500;
}
.property-meta-item svg { width: 14px; height: 14px; color: var(--clr-text-muted); flex-shrink: 0; }
.property-amenities {
  display: flex; flex-wrap: wrap; gap: 6px;
  padding-top: 14px; border-top: 1px solid var(--clr-border-subtle);
  margin-bottom: 14px;
}
.amenity-tag {
  font-size: .75rem; font-weight: 500;
  background: var(--clr-bg);
  padding: 4px 10px; border-radius: var(--radius-full);
  color: var(--clr-text-muted);
}
.property-actions {
  display: flex; gap: 8px;
  padding-top: 14px;
  border-top: 1px solid var(--clr-border-subtle);
}
.property-details {
  display: flex; flex-wrap: wrap; gap: 10px;
  margin-bottom: 10px; font-size: .8125rem; color: var(--clr-text);
}

/* Toggle switch */
.auto-reply-toggle { display: flex; align-items: center; gap: 10px; margin-top: 12px; font-size: .8125rem; color: var(--clr-text-muted); }
.toggle-switch { position: relative; display: inline-block; width: 44px; height: 24px; flex-shrink: 0; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-track {
  position: absolute; inset: 0;
  background: var(--clr-border);
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: background var(--ease-fast);
}
.toggle-track::before {
  content: ''; position: absolute; top: 2px; left: 2px;
  width: 20px; height: 20px; border-radius: 50%;
  background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2);
  transition: transform var(--ease-fast);
}
.toggle-switch input:checked+.toggle-track { background: var(--clr-accent); }
.toggle-switch input:checked+.toggle-track::before { transform: translateX(20px); }

/* ============================================
   CONVERSATIONS — Airbnb messaging style
   ============================================ */
.conversations-list { display: flex; flex-direction: column; gap: 0; }
.conversation-item {
  display: flex; align-items: center; gap: 14px;
  padding: 16px 20px;
  background: var(--clr-surface);
  border-bottom: 1px solid var(--clr-border-subtle);
  cursor: pointer; text-decoration: none;
  transition: background var(--ease-fast);
}
.conversation-item:first-child { border-radius: var(--radius-md) var(--radius-md) 0 0; border: 1px solid var(--clr-border); border-bottom: 1px solid var(--clr-border-subtle); }
.conversation-item:last-child  { border-radius: 0 0 var(--radius-md) var(--radius-md); border: 1px solid var(--clr-border); border-top: none; }
.conversation-item:only-child  { border-radius: var(--radius-md); border: 1px solid var(--clr-border); }
.conversation-item:not(:first-child):not(:last-child) { border-left: 1px solid var(--clr-border); border-right: 1px solid var(--clr-border); }
.conversation-item:hover {
  background: var(--clr-bg);
  text-decoration: none;
}
.conv-avatar {
  width: 48px; height: 48px; border-radius: var(--radius-full);
  background: var(--clr-text);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 1.125rem; font-weight: 700;
  flex-shrink: 0;
}
.conv-info { flex: 1; min-width: 0; }
.conv-info h3 {
  font-size: .9375rem; font-weight: 600; color: var(--clr-text);
  margin-bottom: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.conversation-meta { font-size: .8125rem; color: var(--clr-text-muted); }
.conv-right { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; flex-shrink: 0; }
.conversation-info h3 { font-size: .9375rem; margin-bottom: 4px; }

/* ============================================
   BADGES — Subtle, Airbnb-style
   ============================================ */
.badge {
  display: inline-flex; align-items: center;
  padding: 3px 10px; border-radius: var(--radius-full);
  font-size: .75rem; font-weight: 600; white-space: nowrap;
}
.badge-status-inquiry    { background: var(--clr-warning-light); color: #B06000; }
.badge-status-request    { background: var(--clr-info-light); color: #1565C0; }
.badge-status-confirmed  { background: var(--clr-success-light); color: var(--clr-success); }
.badge-status-checkedin  { background: var(--clr-accent-light); color: var(--clr-accent); }
.badge-status-checkedout { background: var(--clr-bg); color: var(--clr-text-muted); border: 1px solid var(--clr-border); }
.badge.risk-low    { background: var(--clr-success-light); color: var(--clr-success); }
.badge.risk-medium { background: var(--clr-warning-light); color: #B06000; }
.badge.risk-high   { background: var(--clr-danger-light); color: var(--clr-danger); }
.badge.escalate, .badge-escalate { background: var(--clr-danger); color: #fff; }

/* ============================================
   CHAT — Airbnb messaging bubbles
   ============================================ */
.chat-layout { display: grid; grid-template-columns: 1fr 340px; gap: 20px; align-items: start; }
@media (max-width: 900px) { .chat-layout { grid-template-columns: 1fr; } }

.messages-container {
  height: 480px; overflow-y: auto;
  padding: 20px;
  background: var(--clr-surface);
  border-radius: var(--radius-md);
  border: 1px solid var(--clr-border);
  display: flex; flex-direction: column; gap: 12px;
  scroll-behavior: smooth;
}
.messages-container::-webkit-scrollbar { width: 4px; }
.messages-container::-webkit-scrollbar-track { background: transparent; }
.messages-container::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 2px; }

.message {
  max-width: 70%; padding: 12px 16px;
  border-radius: 18px;
  font-size: .875rem; line-height: 1.5;
  animation: msgIn .2s ease;
}
.message.incoming {
  background: var(--clr-bg);
  margin-right: auto;
  border-bottom-left-radius: 4px;
}
.message.outgoing {
  background: var(--clr-primary);
  color: #fff;
  margin-left: auto;
  border-bottom-right-radius: 4px;
}
.message.outgoing .message-time { color: rgba(255,255,255,.6); }
.message-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; gap: 10px; }
.message-sender { font-size: .75rem; font-weight: 700; opacity: .6; }
.message-time { font-size: .75rem; color: var(--clr-text-muted); white-space: nowrap; }
.message-content { white-space: pre-wrap; word-break: break-word; }
.msg-empty { text-align: center; color: var(--clr-text-muted); font-size: .875rem; margin: auto; }

/* ============================================
   AI DRAFT
   ============================================ */
.draft-result {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  padding: 20px;
  margin-top: 16px;
  animation: fadeIn .3s ease;
}
.draft-result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--clr-border-subtle); }
.draft-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; font-size: .8125rem; }
.draft-meta-item { display: flex; align-items: center; gap: 6px; }
.host-note { background: #FDECEA; border-left: 3px solid var(--clr-danger); padding: 12px 16px; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: 12px; font-size: .875rem; }
.missing-questions { background: var(--clr-info-light); border-left: 3px solid var(--clr-info); padding: 12px 16px; border-radius: 0 var(--radius-sm) var(--radius-sm) 0; margin-bottom: 12px; font-size: .875rem; }
.missing-questions ul { margin-left: 16px; margin-top: 6px; color: var(--clr-text); }
.draft-content { background: var(--clr-bg); border: 1px solid var(--clr-border-subtle); padding: 16px; border-radius: var(--radius-sm); white-space: pre-wrap; font-size: .875rem; line-height: 1.6; color: var(--clr-text); margin-bottom: 16px; }
.draft-actions { display: flex; flex-wrap: wrap; gap: 8px; }

/* ============================================
   MODAL
   ============================================ */
.modal {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.5);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000; padding: 20px;
  animation: fadeIn .15s ease;
}
.modal.hidden { display: none; }
.modal-box {
  background: var(--clr-surface);
  border-radius: var(--radius-md);
  width: 100%; max-width: 680px;
  max-height: calc(100vh - 40px); overflow-y: auto;
  box-shadow: var(--shadow-xl);
  animation: modalIn .2s ease;
}
.modal-header {
  position: sticky; top: 0; background: var(--clr-surface);
  display: flex; justify-content: space-between; align-items: center;
  padding: 20px 24px;
  border-bottom: 1px solid var(--clr-border);
  z-index: 2;
  border-radius: var(--radius-md) var(--radius-md) 0 0;
}
.modal-body { padding: 24px; }
.form-section { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--clr-border-subtle); }
.form-section:last-of-type { border-bottom: none; margin-bottom: 0; }
.form-section-title { font-size: .9375rem; font-weight: 600; color: var(--clr-text); margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
.form-section-title svg { width: 18px; height: 18px; color: var(--clr-text-muted); flex-shrink: 0; }

/* ============================================
   WEBHOOK / INTEGRATION — Clean cards
   ============================================ */
.webhook-panel {
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  padding: 20px; margin-bottom: 20px;
}
.webhook-url-display {
  display: flex; align-items: center; gap: 8px;
  background: var(--clr-bg);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: .8125rem; color: var(--clr-text); word-break: break-all;
}

.integration-card {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 20px;
  background: var(--clr-surface);
  border: 1px solid var(--clr-border);
  border-radius: var(--radius-md);
  margin-bottom: 12px;
  transition: border-color var(--ease-fast);
}
.integration-card.connected { border-color: var(--clr-accent); }
.integration-logo {
  width: 48px; height: 48px;
  border-radius: var(--radius-md);
  background: var(--clr-bg);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.integration-logo svg { width: 24px; height: 24px; }
.integration-info { flex: 1; }
.integration-info h4 { font-size: .9375rem; font-weight: 600; margin-bottom: 2px; }
.integration-info p  { font-size: .8125rem; }

/* ============================================
   LOADING & EMPTY STATES
   ============================================ */
.loading {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 60px 20px; color: var(--clr-text-muted); gap: 16px; font-size: .875rem;
}
.spinner {
  width: 36px; height: 36px;
  border: 3px solid var(--clr-border);
  border-top-color: var(--clr-primary);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}
.skeleton {
  background: linear-gradient(90deg, var(--clr-border) 25%, var(--clr-bg) 50%, var(--clr-border) 75%);
  background-size: 200% 100%;
  animation: skeleton-wave 1.4s ease infinite;
  border-radius: var(--radius-sm);
}

.empty-state {
  text-align: center; padding: 60px 20px; color: var(--clr-text-muted);
}
.empty-state-icon { margin-bottom: 16px; display: flex; align-items: center; justify-content: center; }
.empty-state-icon svg { width: 48px; height: 48px; color: var(--clr-text-light); }
.empty-state h3 { font-size: 1.125rem; color: var(--clr-text); margin-bottom: 8px; }
.empty-state p  { font-size: .875rem; margin-bottom: 20px; max-width: 320px; margin-inline: auto; }

/* ============================================
   UTILITIES
   ============================================ */
.hidden { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
.text-center { text-align: center; }
.text-muted { color: var(--clr-text-muted); }
.text-primary { color: var(--clr-primary); }
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.items-center { align-items: center; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }
.mb-1 { margin-bottom: 8px; }
.mb-2 { margin-bottom: 16px; }
.mb-3 { margin-bottom: 24px; }
.mt-2 { margin-top: 16px; }
.mt-3 { margin-top: 24px; }
.divider { border: none; border-top: 1px solid var(--clr-border); margin: 20px 0; }

/* ============================================
   IMPORT PREVIEW
   ============================================ */
.import-preview-card { background: var(--clr-bg); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: 20px; }
.import-preview-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.import-preview-title { font-size: 1.125rem; font-weight: 700; color: var(--clr-text); margin-bottom: 4px; }
.import-preview-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: .8125rem; color: var(--clr-text-muted); }
.import-preview-stats {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px;
  margin-bottom: 16px; padding: 16px;
  background: var(--clr-surface); border-radius: var(--radius-sm); border: 1px solid var(--clr-border);
}
.import-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.import-stat-val { font-size: 1.5rem; font-weight: 800; color: var(--clr-primary); line-height: 1; }
.import-stat-lbl { font-size: .6875rem; color: var(--clr-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
.import-preview-amenities { display: flex; flex-wrap: wrap; gap: 6px; font-size: .8125rem; color: var(--clr-text-muted); }
.import-preview-amenities span { background: var(--clr-surface); border: 1px solid var(--clr-border); padding: 4px 10px; border-radius: var(--radius-sm); }

/* ============================================
   ANIMATIONS
   ============================================ */
@keyframes spin          { to { transform: rotate(360deg); } }
@keyframes fadeIn        { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeInUp      { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
@keyframes msgIn         { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
@keyframes modalIn       { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
@keyframes toastIn       { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
@keyframes toastOut      { from { opacity: 1; } to { opacity: 0; transform: translateY(-10px); } }
@keyframes skeleton-wave { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

section[id^="section-"] { animation: fadeIn .2s ease both; }

/* ============================================
   RESPONSIVE
   ============================================ */
@media (max-width: 640px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .properties-list { grid-template-columns: 1fr; }
  .chat-layout { grid-template-columns: 1fr; }
  .message { max-width: 85%; }
  .import-preview-stats { grid-template-columns: repeat(2, 1fr); }
}
