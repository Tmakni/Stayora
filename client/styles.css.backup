/* ============================================
   AIRBNB AI AGENT - Design System v2
   Modern, accessible, fluid interface
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

/* ---- Design Tokens ---- */
:root {
  --clr-primary:        #FF385C;
  --clr-primary-dark:   #C8001A;
  --clr-primary-light:  #FFECEF;
  --clr-accent:         #00A699;
  --clr-accent-light:   #E0FAF8;
  --clr-bg:             #F7F8FC;
  --clr-surface:        #FFFFFF;
  --clr-border:         #E5E8F0;
  --clr-border-focus:   #FF385C;
  --clr-text:           #111827;
  --clr-text-muted:     #6B7280;
  --clr-text-light:     #9CA3AF;
  --clr-success:        #10B981;
  --clr-success-light:  #D1FAE5;
  --clr-warning:        #F59E0B;
  --clr-warning-light:  #FEF3C7;
  --clr-danger:         #EF4444;
  --clr-danger-light:   #FEE2E2;
  --shadow-sm:   0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --shadow-md:   0 4px 16px rgba(0,0,0,.08);
  --shadow-lg:   0 12px 40px rgba(0,0,0,.12);
  --shadow-xl:   0 24px 64px rgba(0,0,0,.16);
  --radius-sm:   6px;
  --radius-md:   12px;
  --radius-lg:   18px;
  --radius-xl:   24px;
  --radius-full: 9999px;
  --ease-fast:   .15s cubic-bezier(.4,0,.2,1);
  --ease-normal: .25s cubic-bezier(.4,0,.2,1);
  --ease-slow:   .4s  cubic-bezier(.4,0,.2,1);
  --header-h: 68px;
  --sidebar-w: 260px;
  --max-content: 1200px;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  background: var(--clr-bg);
  color: var(--clr-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.skip-link {
  position: absolute; top: -100%; left: 0;
  padding: 12px 20px; background: var(--clr-primary);
  color: #fff; font-weight: 600;
  border-radius: 0 0 var(--radius-md) 0; z-index: 10000;
  transition: top var(--ease-fast);
}
.skip-link:focus { top: 0; }

h1,h2,h3,h4,h5,h6 { font-weight: 700; line-height: 1.3; color: var(--clr-text); }
h1 { font-size: clamp(1.5rem, 3vw, 2rem); }
h2 { font-size: clamp(1.2rem, 2.5vw, 1.5rem); }
h3 { font-size: 1.15rem; }
p  { color: var(--clr-text-muted); }
a  { color: var(--clr-primary); text-decoration: none; transition: color var(--ease-fast); }
a:hover { color: var(--clr-primary-dark); text-decoration: underline; }
a:focus-visible { outline: 2px solid var(--clr-primary); outline-offset: 3px; border-radius: 4px; }

.container { width: 100%; max-width: var(--max-content); margin-inline: auto; padding-inline: clamp(16px, 4vw, 32px); }

/* HEADER */
header {
  position: sticky; top: 0; z-index: 500;
  height: var(--header-h);
  background: rgba(255,255,255,.92);
  border-bottom: 1px solid var(--clr-border);
  box-shadow: 0 1px 0 rgba(0,0,0,.05), 0 2px 16px rgba(0,0,0,.04);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
header .container { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 0; }

.logo { display: flex; align-items: center; gap: 10px; font-size: 1.3rem; font-weight: 800; background: linear-gradient(135deg, var(--clr-primary), #E0001A); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; text-decoration: none; transition: opacity var(--ease-fast); }
.logo:hover { opacity: .8; text-decoration: none; }
.header-nav { display: flex; align-items: center; gap: 12px; }
.user-chip { display: flex; align-items: center; gap: 8px; padding: 6px 14px; background: var(--clr-bg); border: 1px solid var(--clr-border); border-radius: var(--radius-full); font-size: .82rem; color: var(--clr-text-muted); font-weight: 500; }
.user-info { display: flex; align-items: center; gap: 12px; }
.user-email { font-size: .82rem; color: var(--clr-text-muted); font-weight: 500; }

/* BUTTONS */
.btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border: 2px solid transparent; border-radius: var(--radius-md); font-family: inherit; font-size: .875rem; font-weight: 600; cursor: pointer; white-space: nowrap; text-decoration: none; transition: background var(--ease-fast), border-color var(--ease-fast), color var(--ease-fast), box-shadow var(--ease-fast), transform var(--ease-fast); user-select: none; }
.btn:focus-visible { outline: 2px solid var(--clr-primary); outline-offset: 3px; }
.btn:active:not(:disabled) { transform: scale(.97); }
.btn:disabled { opacity: .5; cursor: not-allowed; transform: none; }

.btn-primary { background: linear-gradient(135deg, #FF385C 0%, #E0001A 100%); color: #fff; border-color: transparent; box-shadow: 0 2px 8px rgba(255,56,92,.25); }
.btn-primary:hover:not(:disabled) { background: linear-gradient(135deg, #e02e4f 0%, #C8001A 100%); color: #fff; text-decoration: none; box-shadow: 0 6px 20px rgba(255,56,92,.4); transform: translateY(-1px); }
.btn-primary:active:not(:disabled) { transform: scale(.97) translateY(0); box-shadow: 0 2px 8px rgba(255,56,92,.25); }

.btn-secondary { background: var(--clr-accent); color: #fff; border-color: var(--clr-accent); }
.btn-secondary:hover:not(:disabled) { opacity: .88; color: #fff; text-decoration: none; box-shadow: 0 6px 20px rgba(0,166,153,.3); }

.btn-outline { background: transparent; color: var(--clr-text); border-color: var(--clr-border); }
.btn-outline:hover:not(:disabled) { background: var(--clr-bg); border-color: var(--clr-text-muted); text-decoration: none; }

.btn-ghost { background: transparent; color: var(--clr-text-muted); border-color: transparent; }
.btn-ghost:hover:not(:disabled) { background: var(--clr-bg); color: var(--clr-text); }

.btn-danger { background: var(--clr-danger); color: #fff; border-color: var(--clr-danger); }
.btn-danger:hover:not(:disabled) { opacity: .88; color: #fff; text-decoration: none; }

.btn-sm { padding: 6px 14px; font-size: .8rem; border-radius: var(--radius-sm); }
.btn-lg { padding: 14px 28px; font-size: 1rem; }
.btn-icon { padding: 8px; aspect-ratio: 1; }
.btn-full { width: 100%; justify-content: center; }

/* FORMS */
.form-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 20px; }
label, .form-label { font-size: .85rem; font-weight: 600; color: var(--clr-text); }
.form-hint { font-size: .78rem; color: var(--clr-text-muted); }

input[type="text"],input[type="email"],input[type="password"],input[type="number"],input[type="url"],textarea,select {
  width: 100%; padding: 11px 14px;
  border: 2px solid var(--clr-border);
  border-radius: var(--radius-md);
  font-family: inherit; font-size: .875rem; color: var(--clr-text);
  background: var(--clr-surface);
  transition: border-color var(--ease-fast), box-shadow var(--ease-fast);
  -webkit-appearance: none;
}
textarea { resize: vertical; min-height: 100px; line-height: 1.6; }
input:focus,textarea:focus,select:focus { outline: none; border-color: var(--clr-primary); box-shadow: 0 0 0 4px rgba(255,56,92,.12); }
input::placeholder,textarea::placeholder { color: var(--clr-text-light); }
.form-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 14px; }

.checkbox-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; }
.checkbox-category { grid-column: 1 / -1; font-size: .78rem; font-weight: 700; color: var(--clr-text-muted); text-transform: uppercase; letter-spacing: .06em; padding: 8px 0 2px; border-top: 1px solid var(--clr-border); margin-top: 4px; }
.checkbox-category:first-child { border-top: none; margin-top: 0; padding-top: 0; }
.checkbox-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border: 2px solid var(--clr-border); border-radius: var(--radius-md); cursor: pointer; transition: border-color var(--ease-fast), background var(--ease-fast); background: var(--clr-surface); font-size: .875rem; color: var(--clr-text); font-weight: 500; user-select: none; }
.checkbox-item:hover { border-color: var(--clr-primary); background: var(--clr-primary-light); }
.checkbox-item input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--clr-primary); flex-shrink: 0; }
.checkbox-item input[type="checkbox"]:checked~span { color: var(--clr-primary); font-weight: 600; }

/* CARDS */
.card { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); padding: 24px; box-shadow: var(--shadow-sm); transition: box-shadow var(--ease-normal); }
.card-hover:hover { box-shadow: var(--shadow-md); }
.card-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; margin-bottom: 20px; border-bottom: 1px solid var(--clr-border); }
.card-title { font-size: 1.05rem; font-weight: 700; color: var(--clr-text); }

/* ALERTS */
.alert { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; border-radius: var(--radius-md); font-size: .875rem; font-weight: 500; margin-bottom: 16px; border: 1px solid transparent; }
.alert-error   { background: var(--clr-danger-light);  color: #B91C1C; border-color: #FECACA; }
.alert-success { background: var(--clr-success-light); color: #065F46; border-color: #A7F3D0; }
.alert-warning { background: var(--clr-warning-light); color: #92400E; border-color: #FDE68A; }
.alert-info    { background: var(--clr-accent-light);  color: #065F46; border-color: #99F6E4; }

/* TOAST */
.toast-container { position: fixed; top: calc(var(--header-h) + 16px); right: 20px; z-index: 9000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
.toast { pointer-events: all; min-width: 280px; max-width: 420px; padding: 14px 18px; border-radius: var(--radius-md); font-size: .875rem; font-weight: 500; box-shadow: var(--shadow-xl); display: flex; align-items: center; gap: 10px; animation: toastIn .35s cubic-bezier(.34,1.56,.64,1) forwards; }
.toast.hide { animation: toastOut .25s ease forwards; }
.toast-success { background: #065F46; color: #fff; }
.toast-error   { background: #B91C1C; color: #fff; }
.toast-info    { background: var(--clr-text); color: #fff; }

/* AUTH */
.auth-page { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
@media (max-width: 768px) { .auth-page { grid-template-columns: 1fr; } .auth-hero { display: none; } }

.auth-hero { background: linear-gradient(135deg, #FF385C 0%, #C8001A 50%, #8B0000 100%); display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 48px; color: #fff; text-align: center; position: relative; overflow: hidden; }
.auth-hero::before { content:''; position:absolute; width:400px;height:400px; border-radius:50%; background:rgba(255,255,255,.06); top:-100px;right:-100px; }
.auth-hero::after  { content:''; position:absolute; width:300px;height:300px; border-radius:50%; background:rgba(255,255,255,.06); bottom:-80px;left:-80px; }
.auth-hero-icon { font-size: 5rem; margin-bottom: 24px; }
.auth-hero h1   { font-size: 2rem; color: #fff; margin-bottom: 16px; }
.auth-hero p    { font-size: 1.05rem; color: rgba(255,255,255,.82); max-width: 320px; line-height: 1.7; }
.auth-hero-features { margin-top: 40px; display: flex; flex-direction: column; gap: 14px; text-align: left; width: 100%; max-width: 300px; }
.auth-hero-feature  { display: flex; align-items: center; gap: 12px; font-size: .9rem; color: rgba(255,255,255,.9); }
.auth-hero-feature .feat-icon { width: 32px; height: 32px; border-radius: var(--radius-sm); background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }

.auth-form-side { display: flex; flex-direction: column; justify-content: center; padding: 48px clamp(24px, 6vw, 64px); background: var(--clr-surface); overflow-y: auto; }
.auth-form-header { margin-bottom: 36px; }
.auth-form-header h2 { font-size: 1.6rem; margin-bottom: 8px; }
.auth-form-header p  { font-size: .9rem; }
.auth-switch { margin-top: 24px; text-align: center; font-size: .875rem; color: var(--clr-text-muted); }

/* Legacy compat */
.auth-container { max-width: 420px; margin: 80px auto; padding: 40px; background: var(--clr-surface); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); }
.auth-title { text-align: center; margin-bottom: 32px; font-size: 1.8rem; }

/* DASHBOARD */
.dashboard-layout { display: grid; grid-template-columns: var(--sidebar-w) 1fr; min-height: calc(100vh - var(--header-h)); }
@media (max-width: 900px) { .dashboard-layout { grid-template-columns: 1fr; } .dashboard-sidebar { display: none; } }

.dashboard-sidebar { background: var(--clr-surface); border-right: 1px solid var(--clr-border); padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; position: sticky; top: var(--header-h); height: calc(100vh - var(--header-h)); overflow-y: auto; }
.dashboard-sidebar::-webkit-scrollbar { width: 4px; }
.dashboard-sidebar::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 2px; }
.sidebar-section-label { font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--clr-text-light); padding: 16px 8px 6px; }
.nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: var(--radius-md); font-size: .875rem; font-weight: 500; color: var(--clr-text-muted); cursor: pointer; text-decoration: none; transition: background var(--ease-fast), color var(--ease-fast), transform var(--ease-fast); border: none; background: transparent; width: 100%; text-align: left; }
.nav-item:hover { background: var(--clr-bg); color: var(--clr-text); text-decoration: none; transform: translateX(2px); }
.nav-item.active { background: var(--clr-primary-light); color: var(--clr-primary); font-weight: 600; box-shadow: inset 3px 0 0 var(--clr-primary); }
.nav-icon { font-size: 1.1rem; width: 20px; text-align: center; }
.nav-badge { margin-left: auto; background: var(--clr-primary); color: #fff; font-size: .68rem; font-weight: 700; padding: 2px 7px; border-radius: var(--radius-full); }

.dashboard-main { padding: clamp(20px, 4vw, 36px); overflow-x: hidden; }
.dashboard-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; gap: 12px; }

/* STATS */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 32px; }
.stat-card { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); padding: 22px 24px; box-shadow: var(--shadow-sm); position: relative; overflow: hidden; transition: box-shadow var(--ease-normal), transform var(--ease-normal); animation: fadeInUp .4s ease both; }
.stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.stat-card::before { content:''; position:absolute; top:-24px; right:-24px; width:80px; height:80px; border-radius:50%; opacity:.12; }
.stat-card.stat-blue::before   { background:#3B82F6; }
.stat-card.stat-green::before  { background:var(--clr-accent); }
.stat-card.stat-orange::before { background:var(--clr-warning); }
.stat-card.stat-red::before    { background:var(--clr-danger); }
.stat-card:nth-child(1) { animation-delay: .05s; }
.stat-card:nth-child(2) { animation-delay: .1s; }
.stat-card:nth-child(3) { animation-delay: .15s; }
.stat-card:nth-child(4) { animation-delay: .2s; }
.stat-icon  { font-size: 1.6rem; margin-bottom: 12px; display:block; }
.stat-value { font-size: 2rem; font-weight: 800; color: var(--clr-text); line-height: 1; margin-bottom: 5px; }
.stat-label { font-size: .78rem; color: var(--clr-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }

.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; gap: 12px; }
.section-header h2 { margin: 0; }

/* PROPERTY CARDS */
.properties-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 20px; margin-bottom: 40px; }
.property-card { background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-sm); transition: box-shadow var(--ease-normal), transform var(--ease-normal); animation: fadeInUp .35s ease both; }
.property-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-4px); }
.property-card-accent { height: 5px; background: linear-gradient(90deg, var(--clr-primary) 0%, var(--clr-accent) 100%); }
.property-card-body { padding: 20px; }
.property-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.property-header h3 { font-size: 1.05rem; color: var(--clr-text); flex: 1; padding-right: 8px; }
.property-type { background: var(--clr-bg); border: 1px solid var(--clr-border); padding: 3px 10px; border-radius: var(--radius-full); font-size: .72rem; font-weight: 600; color: var(--clr-text-muted); white-space: nowrap; text-transform: capitalize; }
.property-meta { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-bottom: 14px; }
.property-meta-item { display: flex; align-items: center; gap: 5px; font-size: .82rem; color: var(--clr-text-muted); font-weight: 500; }
.property-amenities { display: flex; flex-wrap: wrap; gap: 6px; padding-top: 14px; border-top: 1px solid var(--clr-border); margin-bottom: 14px; }
.amenity-tag { font-size: .74rem; background: var(--clr-bg); border: 1px solid var(--clr-border); padding: 3px 9px; border-radius: var(--radius-full); color: var(--clr-text-muted); }
.property-actions { display: flex; gap: 8px; padding-top: 14px; border-top: 1px solid var(--clr-border); }
.property-details { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; font-size: 14px; color: var(--clr-text); }

/* Toggle switch */
.auto-reply-toggle { display: flex; align-items: center; gap: 8px; margin-top: 10px; font-size: .82rem; color: var(--clr-text-muted); }
.toggle-switch { position: relative; display: inline-block; width: 40px; height: 22px; flex-shrink: 0; }
.toggle-switch input { opacity: 0; width: 0; height: 0; }
.toggle-track { position: absolute; inset: 0; background: var(--clr-border); border-radius: var(--radius-full); cursor: pointer; transition: background var(--ease-fast); }
.toggle-track::before { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: transform var(--ease-fast); }
.toggle-switch input:checked+.toggle-track { background: var(--clr-accent); }
.toggle-switch input:checked+.toggle-track::before { transform: translateX(18px); }

/* CONVERSATIONS */
.conversations-list { display: flex; flex-direction: column; gap: 10px; }
.conversation-item { display: flex; align-items: center; gap: 16px; padding: 16px 20px; background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); cursor: pointer; text-decoration: none; transition: box-shadow var(--ease-fast), border-color var(--ease-fast), transform var(--ease-fast), background var(--ease-fast); animation: fadeInUp .3s ease both; }
.conversation-item:hover { border-color: var(--clr-primary); box-shadow: var(--shadow-md); transform: translateX(4px); text-decoration: none; background: #FAFAFE; }
.conv-avatar { width: 46px; height: 46px; border-radius: var(--radius-full); background: linear-gradient(135deg, var(--clr-primary), var(--clr-accent)); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.2rem; font-weight: 700; flex-shrink: 0; }
.conv-info { flex: 1; min-width: 0; }
.conv-info h3 { font-size: .95rem; font-weight: 600; color: var(--clr-text); margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.conversation-meta { font-size: .78rem; color: var(--clr-text-muted); }
.conv-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0; }
/* Legacy .conversation-info */
.conversation-info h3 { font-size: .95rem; margin-bottom: 5px; }

/* BADGES */
.badge { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: var(--radius-full); font-size: .73rem; font-weight: 700; white-space: nowrap; }
.badge-status-inquiry    { background: var(--clr-warning-light); color: #92400E; }
.badge-status-request    { background: #DBEAFE; color: #1D4ED8; }
.badge-status-confirmed  { background: var(--clr-success-light); color: #065F46; }
.badge-status-checkedin  { background: var(--clr-accent-light); color: #065F46; }
.badge-status-checkedout { background: var(--clr-bg); color: var(--clr-text-muted); border: 1px solid var(--clr-border); }
.badge.risk-low    { background: var(--clr-success-light); color: #065F46; }
.badge.risk-medium { background: var(--clr-warning-light); color: #92400E; }
.badge.risk-high   { background: var(--clr-danger-light);  color: #B91C1C; }
.badge.escalate    { background: var(--clr-danger); color: #fff; }
.badge-escalate    { background: var(--clr-danger); color: #fff; }

/* CHAT */
.chat-layout { display: grid; grid-template-columns: 1fr 360px; gap: 20px; align-items: start; }
@media (max-width: 900px) { .chat-layout { grid-template-columns: 1fr; } }

.messages-container { height: 420px; overflow-y: auto; padding: 16px; background: var(--clr-bg); border-radius: var(--radius-md); border: 1px solid var(--clr-border); display: flex; flex-direction: column; gap: 12px; scroll-behavior: smooth; }
.messages-container::-webkit-scrollbar { width: 6px; }
.messages-container::-webkit-scrollbar-track { background: transparent; }
.messages-container::-webkit-scrollbar-thumb { background: var(--clr-border); border-radius: 3px; }

.message { max-width: 75%; padding: 12px 16px; border-radius: var(--radius-lg); font-size: .875rem; line-height: 1.6; animation: msgIn .2s ease; }
.message.incoming { background: var(--clr-surface); border: 1px solid var(--clr-border); margin-right: auto; border-bottom-left-radius: 4px; }
.message.outgoing { background: linear-gradient(135deg, #FF385C, #E0001A); color: #fff; margin-left: auto; border-bottom-right-radius: 4px; box-shadow: 0 4px 14px rgba(255,56,92,.25); }
.message.outgoing .message-time { color: rgba(255,255,255,.7); }
.message-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; gap: 12px; }
.message-sender { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; opacity: .8; }
.message-time { font-size: .72rem; color: var(--clr-text-muted); white-space: nowrap; }
.message-content { white-space: pre-wrap; word-break: break-word; }
.msg-empty { text-align: center; color: var(--clr-text-muted); font-size: .875rem; margin: auto; }

/* AI DRAFT */
.draft-result { background: linear-gradient(135deg,#FFFBF0,#FFF9E6); border: 1px solid #FEF08A; border-radius: var(--radius-lg); padding: 20px; margin-top: 20px; animation: fadeIn .3s ease; }
.draft-result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid #FEF08A; }
.draft-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; font-size: .82rem; }
.draft-meta-item { display: flex; align-items: center; gap: 5px; }
.host-note { background: #FEF2F2; border-left: 4px solid var(--clr-danger); padding: 12px 16px; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: 14px; font-size: .875rem; }
.missing-questions { background: #EFF6FF; border-left: 4px solid #3B82F6; padding: 12px 16px; border-radius: 0 var(--radius-md) var(--radius-md) 0; margin-bottom: 14px; font-size: .875rem; }
.missing-questions ul { margin-left: 16px; margin-top: 6px; color: var(--clr-text); }
.draft-content { background: var(--clr-surface); border: 1px solid var(--clr-border); padding: 16px; border-radius: var(--radius-md); white-space: pre-wrap; font-size: .9rem; line-height: 1.7; color: var(--clr-text); margin-bottom: 16px; }
.draft-actions { display: flex; flex-wrap: wrap; gap: 10px; }

/* MODAL */
.modal { position: fixed; inset: 0; background: rgba(17,24,39,.55); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px; animation: fadeIn .2s ease; }
.modal.hidden { display: none; }
.modal-box { background: var(--clr-surface); border-radius: var(--radius-xl); width: 100%; max-width: 720px; max-height: calc(100vh - 40px); overflow-y: auto; box-shadow: var(--shadow-xl); animation: modalIn .25s cubic-bezier(.34,1.56,.64,1); }
.modal-header { position: sticky; top: 0; background: var(--clr-surface); display: flex; justify-content: space-between; align-items: center; padding: 24px 28px 20px; border-bottom: 1px solid var(--clr-border); z-index: 2; }
.modal-body { padding: 28px; }
.form-section { margin-bottom: 28px; padding-bottom: 24px; border-bottom: 1px solid var(--clr-border); }
.form-section:last-of-type { border-bottom: none; margin-bottom: 0; }
.form-section-title { font-size: .95rem; font-weight: 700; color: var(--clr-text); margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }

/* WEBHOOK */
.webhook-panel { background: linear-gradient(135deg,#F0FDF4,#DCFCE7); border: 1px solid #BBF7D0; border-radius: var(--radius-lg); padding: 20px; margin-bottom: 20px; }
.webhook-url-display { display: flex; align-items: center; gap: 10px; background: var(--clr-surface); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: 10px 14px; font-family: 'SFMono-Regular',Consolas,monospace; font-size: .82rem; color: var(--clr-text); word-break: break-all; }

/* INTEGRATION */
.integration-card { display: flex; align-items: center; gap: 16px; padding: 18px 22px; background: var(--clr-surface); border: 2px solid var(--clr-border); border-radius: var(--radius-lg); margin-bottom: 14px; transition: border-color var(--ease-fast); }
.integration-card.connected { border-color: var(--clr-accent); background: var(--clr-accent-light); }
.integration-logo { width: 48px; height: 48px; border-radius: var(--radius-md); background: var(--clr-bg); display: flex; align-items: center; justify-content: center; font-size: 1.8rem; flex-shrink: 0; border: 1px solid var(--clr-border); }
.integration-info { flex: 1; }
.integration-info h4 { font-size: .95rem; margin-bottom: 3px; }
.integration-info p  { font-size: .8rem; }

/* LOADING */
.loading { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; color: var(--clr-text-muted); gap: 14px; font-size: .9rem; }
.spinner { width: 36px; height: 36px; border: 3px solid var(--clr-border); border-top-color: var(--clr-primary); border-radius: 50%; animation: spin .8s linear infinite; }
.skeleton { background: linear-gradient(90deg,var(--clr-border) 25%,var(--clr-bg) 50%,var(--clr-border) 75%); background-size: 200% 100%; animation: skeleton-wave 1.4s ease infinite; border-radius: var(--radius-sm); }

/* EMPTY STATE */
.empty-state { text-align: center; padding: 60px 24px; color: var(--clr-text-muted); }
.empty-state-icon { font-size: 3.5rem; margin-bottom: 16px; opacity: .6; }
.empty-state h3   { font-size: 1.1rem; color: var(--clr-text); margin-bottom: 8px; }
.empty-state p    { font-size: .875rem; margin-bottom: 24px; max-width: 320px; margin-inline: auto; }

/* UTILITIES */
.hidden { display: none !important; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
.text-center { text-align: center; }
.text-muted { color: var(--clr-text-muted); }
.text-primary { color: var(--clr-primary); }
.flex { display: flex; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.items-center { align-items: center; }
.gap-2 { gap: 8px; }
.gap-3 { gap: 12px; }
.gap-4 { gap: 16px; }
.mb-1 { margin-bottom: 8px; }
.mb-2 { margin-bottom: 16px; }
.mb-3 { margin-bottom: 24px; }
.mt-2 { margin-top: 16px; }
.mt-3 { margin-top: 24px; }
.divider { border: none; border-top: 1px solid var(--clr-border); margin: 20px 0; }

/* ANIMATIONS */
@keyframes spin            { to { transform: rotate(360deg); } }
@keyframes fadeIn          { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeInUp        { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
@keyframes msgIn           { from { opacity: 0; transform: translateY(8px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes modalIn         { from { opacity: 0; transform: scale(.93) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }
@keyframes toastIn         { from { opacity: 0; transform: translateX(40px) scale(.96); } to { opacity: 1; transform: translateX(0) scale(1); } }
@keyframes toastOut        { from { opacity: 1; transform: translateX(0); } to { opacity: 0; transform: translateX(40px); } }
@keyframes skeleton-wave   { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* IMPORT PREVIEW */
.import-preview-card { background: var(--clr-bg); border: 1px solid var(--clr-border); border-radius: var(--radius-lg); padding: 20px; }
.import-preview-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
.import-preview-title { font-size: 1.1rem; font-weight: 700; color: var(--clr-text); margin-bottom: 6px; }
.import-preview-meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.import-preview-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 16px; padding: 16px; background: var(--clr-surface); border-radius: var(--radius-md); border: 1px solid var(--clr-border); }
.import-stat { display: flex; flex-direction: column; align-items: center; gap: 4px; }
.import-stat-val { font-size: 1.5rem; font-weight: 800; color: var(--clr-primary); line-height: 1; }
.import-stat-lbl { font-size: .72rem; color: var(--clr-text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .03em; }
.import-preview-amenities { display: flex; flex-wrap: wrap; gap: 8px; font-size: .82rem; color: var(--clr-text-muted); }
.import-preview-amenities span { background: var(--clr-surface); border: 1px solid var(--clr-border); padding: 4px 10px; border-radius: var(--radius-sm); }

/* SECTION TRANSITIONS */
section[id^="section-"] { animation: fadeInUp .3s ease both; }

@media (max-width: 640px) {
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .properties-list { grid-template-columns: 1fr; }
  .chat-layout { grid-template-columns: 1fr; }
  .message { max-width: 90%; }
  header { height: auto; min-height: var(--header-h); }
  .import-preview-stats { grid-template-columns: repeat(2, 1fr); }
}
