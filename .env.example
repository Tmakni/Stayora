# ============================================================
# Stayora — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais commiter .env dans git.
# ============================================================

# ── Serveur ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Sécurité JWT (OBLIGATOIRE en production, >= 32 caractères) ─
JWT_SECRET=change_me_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Clé de chiffrement AES-256 pour les tokens OAuth Gmail (>= 32 chars)
# Si absent, JWT_SECRET est utilisé à la place
ENCRYPTION_KEY=change_me_another_long_random_secret_32chars

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano

# ── Base de données ─────────────────────────────────────────
# Option A : MySQL cloud (PlanetScale, Aiven, Railway, etc.)
USE_MEMORY_DB=false
DB_HOST=your_cloud_mysql_host
DB_PORT=3306
DB_USER=your_cloud_mysql_user
DB_PASSWORD=your_cloud_mysql_password
DB_NAME=your_database_name
DB_SSL=true

# Option B : SQLite intégré (Render free tier / tests rapides)
# USE_MEMORY_DB=true   → ignore toutes les variables DB_* ci-dessus

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ── Google OAuth (Gmail) ─────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Remplacer par votre vrai domaine Render après le premier déploiement
GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/api/gmail/oauth-callback

# ── CORS (domaine de l'app en production) ────────────────────
APP_URL=https://your-app-name.onrender.com

# ── SMTP — emails transactionnels (OBLIGATOIRE en production) ─
# Utilisés par « mot de passe oublié » et la confirmation de changement
# de mot de passe (server/controllers/authController.js).
#
# ATTENTION : si SMTP_USER / SMTP_PASS sont absents, l'application NE PLANTE
# PAS — elle se contente d'écrire le lien de réinitialisation dans les logs
# serveur. En production cela signifie que « mot de passe oublié » ne renvoie
# jamais d'email : l'utilisateur reste bloqué dehors, sans aucune erreur visible.
# Pour Gmail, SMTP_PASS doit être un « mot de passe d'application », pas le
# mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# ── Superhot channel manager (optionnel) ─────────────────────
SUPERHOT_API_KEY=your_superhot_api_key
SUPERHOT_ACCOUNT_KEY=your_superhot_account_key
SUPERHOT_WEBHOOK_SECRET=your_superhot_webhook_secret
