# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
# Modèle OpenAI (fine-tuné ou standard). Fallback: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# MySQL (optionnel - fallback memoire si non configure)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=airbnb_ai_agent

# App
USE_MEMORY_DB=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Superhot channel manager (https://superhot.io)
# Obtenez ces cles dans votre tableau de bord Superhot > Developer > API
SUPERHOT_API_KEY=your-superhot-api-key
SUPERHOT_ACCOUNT_KEY=your-superhot-account-key
# Secret pour valider les webhooks entrants (defini dans Superhot > Webhooks)
SUPERHOT_WEBHOOK_SECRET=your-superhot-webhook-secret
