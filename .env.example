# ============================================================
# Stayora — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais commiter .env dans git.
# ============================================================

# ── Serveur ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Sécurité JWT (OBLIGATOIRE en production, >= 32 caractères) ─
JWT_SECRET=change_me_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Clé de chiffrement AES-256 pour les tokens OAuth Gmail (>= 32 chars)
# Si absent, JWT_SECRET est utilisé à la place
ENCRYPTION_KEY=change_me_another_long_random_secret_32chars

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano

# ── Base de données ─────────────────────────────────────────
# Option A : MySQL cloud (PlanetScale, Aiven, Railway, etc.)
USE_MEMORY_DB=false
DB_HOST=your_cloud_mysql_host
DB_PORT=3306
DB_USER=your_cloud_mysql_user
DB_PASSWORD=your_cloud_mysql_password
DB_NAME=your_database_name
DB_SSL=true

# Option B : SQLite intégré
# USE_MEMORY_DB=true   → ignore toutes les variables DB_* ci-dessus
#
# ATTENTION — le nom est trompeur : USE_MEMORY_DB=true ne veut PAS dire « base
# en RAM ». Il sélectionne le chemin SQLite (voir knexfile.js), c'est-à-dire un
# FICHIER. Toute la question est de savoir OÙ vit ce fichier.
#
# SQLITE_DB_PATH désigne ce fichier. Si la variable n'est pas posée, knexfile.js
# retombe sur ~/.local/share/airbnb-ai-agent/airbnb_ai_agent.db, c'est-à-dire un
# chemin À L'INTÉRIEUR du conteneur : il est recréé vide à chaque déploiement, et
# avec lui disparaissent les comptes, les logements, les conversations et les
# jetons Gmail.
#
# En PRODUCTION, l'application REFUSE désormais de démarrer dans ce cas
# (server/config/persistence.js) plutôt que d'accepter des inscriptions qu'un
# redéploiement effacera. Pointez SQLITE_DB_PATH vers un VOLUME PERSISTANT :
#
#   Render  : disque monté sur /data (déjà décrit dans render.yaml)
#   Railway : créer un Volume, le monter sur /data
#   Fly.io  : fly volumes create, puis [mounts] dans fly.toml
#
# SQLITE_DB_PATH=/data/airbnb_ai_agent.db

# Environnements volontairement jetables (aperçu de branche, démonstration) où
# la perte de données est assumée. À ne JAMAIS poser sur l'environnement réel.
# ALLOW_EPHEMERAL_DB=true

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ── Google OAuth (Gmail) ─────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Remplacer par votre vrai domaine Render après le premier déploiement
GOOGLE_REDIRECT_URI=https://your-app-name.onrender.com/api/gmail/oauth-callback

# ── CORS (domaine de l'app en production) ────────────────────
APP_URL=https://your-app-name.onrender.com

# ── SMTP — emails transactionnels (OBLIGATOIRE en production) ─
# Utilisés par « mot de passe oublié » et la confirmation de changement
# de mot de passe (server/controllers/authController.js).
#
# ATTENTION : si SMTP_USER / SMTP_PASS sont absents, l'application NE PLANTE
# PAS — elle se contente d'écrire le lien de réinitialisation dans les logs
# serveur. En production cela signifie que « mot de passe oublié » ne renvoie
# jamais d'email : l'utilisateur reste bloqué dehors, sans aucune erreur visible.
# Pour Gmail, SMTP_PASS doit être un « mot de passe d'application », pas le
# mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASS=votre_mot_de_passe_application

# ── Superhot channel manager (optionnel) ─────────────────────
SUPERHOT_API_KEY=your_superhot_api_key
SUPERHOT_ACCOUNT_KEY=your_superhot_account_key
SUPERHOT_WEBHOOK_SECRET=your_superhot_webhook_secret

# ── Lecture des annonces d'un profil hôte Airbnb ─────────────────────────────
#
# Airbnb ne livre plus les annonces d'un hôte dans le HTML de sa page de profil :
# la page arrive vide et se remplit en JavaScript. Mesuré sur une page réelle :
# requête HTTP simple = 0 annonce, navigateur = 10 annonces avec leurs titres.
# L'import « toutes mes annonces » ouvre donc réellement la page avec Chromium.
#
# CHROME_PATH : emplacement du binaire. L'image Docker le pose déjà
# (/usr/bin/chromium-browser, paquet `chromium` d'Alpine). En local, le module
# trouve seul un Chrome installé ; renseignez cette variable si le vôtre est
# ailleurs.
# CHROME_PATH=/usr/bin/chromium-browser
#
# AIRBNB_BROWSER_SCAN=false désactive complètement le navigateur. À poser sur un
# hébergement trop juste en mémoire : un Chromium consomme autant que le reste
# de l'application. L'import par profil bascule alors sur l'export de données,
# qui ne dépend d'aucune lecture de page.
# AIRBNB_BROWSER_SCAN=false
