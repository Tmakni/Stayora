{
  "name": "airbnb-ai-agent",
  "version": "1.0.0",
  "description": "MVP Agent IA pour hôtes Airbnb - génération de réponses intelligentes",
  "main": "server/server.js",
  "scripts": {
    "prestart": "node prestart.js",
    "predev": "node prestart.js",
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "dev:wsl": "bash -c 'source ~/.nvm/nvm.sh && nvm use 20 --silent && npx nodemon server/server.js'",
    "wsl": "wsl.exe -e bash -lc \"source ~/.nvm/nvm.sh && nvm use 20 >/dev/null && cd /mnt/c/home/tom/airbnb-ai-agent && npm start\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --verbose",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "db:migrate": "node -e \"const k=require('knex')(require('./knexfile').development); k.migrate.latest().then(([b,m])=>{console.log(m.length?'Migrated: '+m.join(', '):'Already up to date'); k.destroy()})\"",
    "db:rollback": "node -e \"const k=require('knex')(require('./knexfile').development); k.migrate.rollback().then(([b,m])=>{console.log('Rolled back: '+m.join(', ')); k.destroy()})\"",
    "dev:mobile": "node scripts/dev-mobile.js",
    "stop": "node scripts/stop-server.js",
    "diagnose": "node scripts/diagnose-state.js",
    "backfill:headers": "node scripts/backfill-reply-headers.js"
  },
  "keywords": [
    "airbnb",
    "ai",
    "agent",
    "chatbot"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@googleapis/gmail": "^16.1.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.6.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.6.5",
    "node-ical": "^0.26.0",
    "nodemailer": "^9.0.5",
    "openai": "^4.20.1",
    "puppeteer-core": "^23.11.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
